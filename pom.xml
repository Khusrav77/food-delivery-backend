<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.marketplace</groupId>
    <artifactId>my-marketplace</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>my-marketplace</name>
    <description>Modular monolith marketplace backend</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!-- Shared modules -->

            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>common-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>event-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>test-support</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Domain modules -->

            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>identity</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>user</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>franchise</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>catalog</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>inventory</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>cart</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>ordering</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>payment</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>delivery</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>notification</artifactId>
                <version>${project.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <modules>
        <module>application</module>

        <module>platform</module>

        <module>shared/common-core</module>
        <module>shared/event-api</module>
        <module>shared/test-support</module>

        <module>modules/identity</module>
        <module>modules/user</module>
        <module>modules/franchise</module>
        <module>modules/catalog</module>
        <module>modules/inventory</module>
        <module>modules/cart</module>
        <module>modules/ordering</module>
        <module>modules/payment</module>
        <module>modules/delivery</module>
        <module>modules/notification</module>
    </modules>

</project>